# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true, account=my, useCliWithServiceAccount=true, token=$OP_SERVICE_ACCOUNT_TOKEN)
# @currentEnv=$APP_ENV
# ---

# @sensitive @required=false
OP_SERVICE_ACCOUNT_TOKEN=

# @type=enum(dev,ci,production,staging) @required
APP_ENV=dev

# Pipeline (embed) to API authentication key
# @required @sensitive
PIPELINE_API_KEY=op(op://Paperwall/Development/PIPELINE_API_KEY)

# Tigris S3-compatible storage credentials (production only)
# @sensitive
AWS_ACCESS_KEY_ID=op(op://Paperwall/Production/AWS_ACCESS_KEY_ID)

# @sensitive
AWS_SECRET_ACCESS_KEY=op(op://Paperwall/Production/AWS_SECRET_ACCESS_KEY)

# @type=url
AWS_ENDPOINT_URL_S3=https://t3.storage.dev

# @type=url
AWS_ENDPOINT_URL_IAM=https://iam.storage.dev

AWS_REGION=auto
